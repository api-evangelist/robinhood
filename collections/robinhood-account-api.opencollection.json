{
  "opencollection": "1.0.0",
  "info": {
    "name": "Robinhood Crypto Trading Account API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get crypto trading account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://trading.robinhood.com/api/v1/crypto/trading/accounts/"
          },
          "docs": "Returns the authenticated user's crypto trading account, including account number and status."
        }
      ]
    }
  ],
  "bundled": true
}